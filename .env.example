# No environment variables are required for the current local-first MVP.
#
# Add these only when the Firebase backend is implemented. Set them in
# Vercel Project Settings > Environment Variables for Production, Preview,
# and Development. Never commit the real values to Git.
#
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_PROJECT_ID=
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_APP_ID=

# Enable the private S3 archive for weekly rough-work PDFs.
# Use an IAM user or role with PutObject permission only for this bucket/prefix.
# AWS_REGION=
# AWS_S3_BUCKET=
# AWS_S3_PREFIX=weekly-rough-work
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
